[options]

admin_passwd = {{ odoo_master_password }}

db_host = False
db_port = 5432
db_user = {{ odoo_db_user }}
db_password = {{ odoo_db_password }}

# Keep the built-in database wizard enabled: no db_name/dbfilter here, so
# the first time the instance is opened in a browser, Odoo shows its normal
# "Create Database" screen (Master Password / DB Name / Email / Password /
# Language / Country / Demo data) instead of a pre-created login page.
list_db = True

addons_path = {{ odoo_source }}/addons,{{ odoo_custom_addons }},{{ oca_dir }}

data_dir = {{ odoo_home }}/data

logfile = {{ odoo_home }}/logs/odoo.log

http_port = 8069
http_interface = 0.0.0.0

proxy_mode = True

workers = {{ odoo_workers }}
max_cron_threads = {{ odoo_max_cron_threads }}
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648
limit_time_cpu = 600
limit_time_real = 1200
limit_request = 8192
{% if odoo_dev_mode | default('no') == 'yes' %}
dev_mode = reload,qweb,xml
{% endif %}
